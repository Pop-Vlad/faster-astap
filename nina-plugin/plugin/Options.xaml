<ResourceDictionary
    x:Class="FasterAstap.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  N.I.N.A. finds this by a key of "<AssemblyTitle>_Options", so the name
          here and the AssemblyTitle attribute have to agree exactly. The data
          context is the FasterAstapPlugin instance.  -->
    <DataTemplate x:Key="Faster ASTAP_Options">
        <StackPanel Margin="10" Orientation="Vertical">

            <TextBlock FontWeight="Bold" Text="Status" />
            <TextBlock Margin="0,4,0,0" Text="{Binding StatusSummary}" TextWrapping="Wrap" />
            <!--  Empty when there is nothing to say, which renders as nothing. A
                  converter to collapse it would mean depending on one of
                  N.I.N.A.'s resources resolving in this scope, for no gain.  -->
            <TextBlock Margin="0,2,0,0" Text="{Binding Activity}" TextWrapping="Wrap" />

            <CheckBox Margin="0,12,0,0"
                      Content="Use for plate solving (points N.I.N.A.'s ASTAP path at this solver)"
                      IsChecked="{Binding UseForPlateSolving}" />
            <TextBlock Margin="20,2,0,0"
                       Opacity="0.7"
                       Text="{Binding AstapLocationInUse, StringFormat='ASTAP path is now: {0}'}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="20,2,0,0"
                       Opacity="0.7"
                       Text="N.I.N.A. runs this solver in ASTAP's place, once per plate solve, and reads the same .ini back. Unticking restores the previous path."
                       TextWrapping="Wrap" />
            <TextBlock Margin="20,2,0,0"
                       Opacity="0.7"
                       Text="N.I.N.A. has no way to list a plugin as a plate solver, so the dropdown still says ASTAP."
                       TextWrapping="Wrap" />

            <TextBlock Margin="0,16,0,0" FontWeight="Bold" Text="Star database" />
            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                <TextBlock Width="150" Text="Database directory" VerticalAlignment="Center" />
                <TextBox Width="380" Text="{Binding DatabaseDirectory, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <TextBlock Margin="150,2,0,0"
                       Opacity="0.7"
                       Text="The folder holding the .1476 or .290 files. Left empty, the ASTAP installation already configured is used."
                       TextWrapping="Wrap" />

            <TextBlock Margin="0,16,0,0" FontWeight="Bold" Text="Index" />
            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                <TextBlock Width="150" Text="Depth tiers" VerticalAlignment="Center" />
                <TextBox Width="200" Text="{Binding Tiers, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Margin="8,0,0,0"
                           Opacity="0.7"
                           Text="empty = all twelve (3.1 GB); e.g. 60,125,250,500 = 1.3 GB"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                <TextBlock Width="150" Text="Deepen ladder to" VerticalAlignment="Center" />
                <TextBox Width="80" Text="{Binding MaxTier, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Margin="8,0,0,0"
                           Opacity="0.7"
                           Text="stars/deg² — 0 is off. Worth it below 0.25°, and costly: 1800 adds 2.5 GB, 3600 another 4.8."
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                <TextBlock Width="150" Text="Worker threads" VerticalAlignment="Center" />
                <TextBox Width="80" Text="{Binding Threads, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Margin="8,0,0,0"
                           Opacity="0.7"
                           Text="0 = one per hardware thread"
                           VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0" Text="{Binding CacheSummary}" TextWrapping="Wrap" />
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                <Button Width="180"
                        Margin="0,0,6,0"
                        Command="{Binding PrepareCommand}"
                        Content="Build the index now" />
                <Button Width="110" Command="{Binding RefreshCommand}" Content="Refresh" />
            </StackPanel>
            <TextBlock Margin="0,2,0,0"
                       Opacity="0.7"
                       Text="A cached index costs nothing to read: the files are memory mapped, so the pages one solve touches stay in memory for the ones after it. Building a ladder that has never been built takes minutes, and this is how to spend them before a session rather than on the first frame of it."
                       TextWrapping="Wrap" />

            <TextBlock Margin="0,16,0,0" FontWeight="Bold" Text="Last solves" />
            <TextBlock Margin="0,4,0,0"
                       FontFamily="Consolas"
                       Opacity="0.8"
                       Text="{Binding RecentLog}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,2,0,0"
                       Opacity="0.7"
                       Text="{Binding LogPath, StringFormat='From {0}, which is where the solver reports: N.I.N.A. runs it with no console to print to.'}"
                       TextWrapping="Wrap" />

            <TextBlock Margin="0,16,0,0" FontWeight="Bold" Text="Removing it" />
            <CheckBox Margin="0,6,0,0"
                      Content="Delete the index cache when the plugin is uninstalled"
                      IsChecked="{Binding RemoveCacheOnUninstall}" />
            <TextBlock Margin="20,2,0,0"
                       Opacity="0.7"
                       Text="The cache belongs to the star database rather than to this plugin, so a command line astap_index_solve on this machine shares it. Deleting costs no data — it is rebuilt on next use — but that rebuild takes minutes."
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,0"
                       Opacity="0.7"
                       Text="Uninstalling restores the previous ASTAP path by itself. The button below does the same without waiting, for a machine you want cleared now."
                       TextWrapping="Wrap" />
            <Button Width="260"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding CleanUpCommand}"
                    Content="Restore ASTAP and remove everything" />

        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
